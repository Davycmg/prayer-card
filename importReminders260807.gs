/**
 * 匯入「提醒事項_安祺禱告」PDF 內容到「表單回覆 1」工作表
 * 試算表：https://docs.google.com/spreadsheets/d/1h6ptOLTHHZfUXvjOlZxsYrCSoL1Jp2DBNexYdy_g75Y/
 *
 * 欄位對應（依「表單回覆 1」現有標題列）：
 *   A 時間戳記   -> 留空（PDF 沒有建立時間，只有下次提醒日期）
 *   B 事項       -> 提醒事項文字
 *   C DG 週期    -> 重複頻率代碼（Y每年 / HY每半年 / S每季 / M每月 / DW每兩週 / W每週，沒有日期的項目留空）
 *   D 備註       -> 留空
 *   E            -> PDF 上的日期（含時間，若有），依你的要求寫入此欄
 *   F 本次禱告完成 -> 留空
 *   G 下次禱告時間 -> 留空
 *   H 標籤       -> 統一寫入「A安祺禱告」（不採用 PDF 原始標籤）
 *
 * 使用方式：
 *   1. 開啟試算表 -> 擴充功能 -> Apps Script
 *   2. 新增檔案，貼上這整份程式碼
 *   3. 執行 importReminders260807()，第一次執行會要求授權
 *   4. 完成後可在「表單回覆 1」看到新匯入的 65 筆資料（附加在既有資料最後一列之後）
 *
 * 資料以 Base64 編碼內嵌（避免跳脫字元問題），執行時會自動解碼還原成 JSON。
 * 有 5 筆項目在 PDF 中只有標籤、沒有日期，這幾筆的 C、E 欄會留空。
 * 「今天/明天/前天/後天」等相對日期已依 PDF 產生日期（2026/8/7）換算成實際日期。
 */

var REMINDER_IMPORT_260807_SPREADSHEET_ID = '1h6ptOLTHHZfUXvjOlZxsYrCSoL1Jp2DBNexYdy_g75Y';
var REMINDER_IMPORT_260807_SHEET_NAME = '表單回覆 1';

// 從 PDF 解析出的資料（共 65 筆），以 Base64 編碼的 JSON 字串內嵌
var REMINDER_IMPORT_260807_DATA_B64 =
  '';

function importReminders260807() {
  var jsonText = Utilities.newBlob(Utilities.base64Decode(REMINDER_IMPORT_260807_DATA_B64))
    .getDataAsString('UTF-8');
  var data = JSON.parse(jsonText);

  var ss = SpreadsheetApp.openById(REMINDER_IMPORT_260807_SPREADSHEET_ID);
  var sheet = ss.getSheetByName(REMINDER_IMPORT_260807_SHEET_NAME);
  if (!sheet) {
    throw new Error('找不到工作表：' + REMINDER_IMPORT_260807_SHEET_NAME);
  }

  var rows = data.map(function (r) {
    var dateValue = '';
    if (r.date) {
      var parts = r.date.split('/');
      var y = parseInt(parts[0], 10);
      var m = parseInt(parts[1], 10) - 1;
      var d = parseInt(parts[2], 10);
      var hh = 0, mm = 0;
      if (r.time) {
        var t = r.time.split(':');
        hh = parseInt(t[0], 10);
        mm = parseInt(t[1], 10);
      }
      dateValue = new Date(y, m, d, hh, mm);
    }
    return [
      '',            // A 時間戳記
      r.item,        // B 事項
      r.freq,        // C DG 週期
      '',            // D 備註
      dateValue,     // E 日期（依需求寫入這欄）
      '',            // F 本次禱告完成
      '',            // G 下次禱告時間
      'A安祺禱告'      // H 標籤（統一標記，不採用 PDF 原始標籤）
    ];
  });

  var startRow = sheet.getLastRow() + 1;
  sheet.getRange(startRow, 1, rows.length, 8).setValues(rows);

  // 把有日期的 E 欄格式化成日期時間，方便閱讀
  sheet.getRange(startRow, 5, rows.length, 1).setNumberFormat('yyyy/MM/dd HH:mm');

  SpreadsheetApp.getUi().alert('匯入完成，共新增 ' + rows.length + ' 筆資料。');
}
